{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-roleplay-chat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "AI_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "APP_ENV": "local"
  },
  "env": {
    "dev": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "AI_PROVIDER": "openai",
        "OPENAI_MODEL": "gpt-5.6-luna",
        "APP_ENV": "development"
      },
      "secrets": {
        "required": ["OPENAI_API_KEY", "DEV_ACCESS_TOKEN"]
      },
      "ratelimits": [
        {
          "name": "CHAT_RATE_LIMITER",
          "namespace_id": "2026090901",
          "simple": { "limit": 10, "period": 60 }
        }
      ]
    }
  }
}
