{
  "name": "ai-roleplay-chat-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --env \"\" --dry-run --outdir dist",
    "build:dev": "wrangler deploy --env dev --dry-run --outdir dist/dev",
    "deploy:dev": "wrangler deploy --env dev",
    "check": "npm run typecheck && npm test && npm run build && npm run build:dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
